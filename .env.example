# Copy to .env and load it with:  set -a; source .env; set +a      (macOS/Linux)
# Windows PowerShell: set each variable with  $env:NAME="value"
DRIFTGUARD_ARTIFACTS_DIR=artifacts
DRIFTGUARD_SEED=42
# comma list from: ks,psi,domain_classifier,evidently
DRIFTGUARD_DETECTORS=ks,psi,domain_classifier
# never | performance_only | drift_only | drift_and_performance | drift_or_performance
DRIFTGUARD_POLICY=drift_or_performance
# auto = use MLflow if installed; true = require it; false = disable
DRIFTGUARD_MLFLOW=auto
DRIFTGUARD_MLFLOW_EXPERIMENT=driftguard
# Optional override; default is a local SQLite file under artifacts/mlflow/
# MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow/mlflow.db
DRIFTGUARD_AUTO_TRAIN=true
DRIFTGUARD_LOG_LEVEL=INFO
